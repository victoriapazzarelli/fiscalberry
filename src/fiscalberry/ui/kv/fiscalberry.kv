#:kivy 2.3.0


<MainLayout>:
    title: "Fiscalberry App Iupi!"
    orientation: 'vertical'
    
    canvas.before:
        Rectangle:
            pos: self.pos
            size: self.size
            source: app.background_image
    

    BoxLayout:
        orientation: 'vertical'
        padding: 10

        Image:
            source: app.logo_image
            size_hint_y: None
            height: 96
            allow_stretch: True
            keep_ratio: True
            color: 1, 1, 1, 1
            margin_bottom: 10

        Label:
            id: title_label
            text: "Print Server"
            font_size: 32
            bold: True
            size_hint_y: None
            height: 64
            color: 0, 0, 128, 1
            margin_bottom: 10


        Label:
            id: conectado_label
            text: "Conectado!" if app.connected else "Desconectado"
            color: (0, 128, 0, 1) if app.connected else (128, 0, 0, 1)
            font_size: 48

        Button:
            id: connect_button
            text: "Conectar" if not app.connected else "Desconectar"
            on_press: app.start_service() if not app.connected else app.stop_service()
            size_hint_y: None
            height: 64
            background_color: (0, 128, 0, 1) if app.connected else (128, 0, 0, 1)
            color: 1, 1, 1, 1


        Label:
            id: uuid_label
            text: app.uuidSmall
            font_size: 16
            size_hint_y: None
            height: 40
            color: 128, 0, 0, 1
            

        TextInput:
            id: host_input
            text: app.sioServerUrl
            multiline: False
            size_hint_y: None
            height: 40
            on_text: app.store_new_host(self.text)

        # Sección de Drivers de Impresoras
        Label:
            text: "Drivers de Impresoras"
            font_size: 20
            bold: True
            size_hint_y: None
            height: 40
            color: 0, 0, 128, 1

        ScrollView:
            size_hint_y: None
            height: 300
            do_scroll_x: False
            do_scroll_y: True
            
            GridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: 5
                padding: 10
                
                Button:
                    text: "Sam4S Giant - 100"
                    size_hint_y: None
                    height: 50
                    background_color: 0.2, 0.6, 0.9, 1
                    color: 1, 1, 1, 1
                    on_press: app.root.get_screen('main').open_sam4s_driver()
                
                Button:
                    text: "Citizen CT-S310II"
                    size_hint_y: None
                    height: 50
                    background_color: 0.2, 0.6, 0.9, 1
                    color: 1, 1, 1, 1
                    on_press: app.root.get_screen('main').open_citizen_driver()
                
                Button:
                    text: "Epson TM-T20"
                    size_hint_y: None
                    height: 50
                    background_color: 0.2, 0.6, 0.9, 1
                    color: 1, 1, 1, 1
                    on_press: app.root.get_screen('main').open_epson_tm20_driver()
                
                Button:
                    text: "Drivers Genéricos POS"
                    size_hint_y: None
                    height: 50
                    background_color: 0.2, 0.6, 0.9, 1
                    color: 1, 1, 1, 1
                    on_press: app.root.get_screen('main').open_generic_pos_driver()
                
                Button:
                    text: "Epson TM-T88V"
                    size_hint_y: None
                    height: 50
                    background_color: 0.2, 0.6, 0.9, 1
                    color: 1, 1, 1, 1
                    on_press: app.root.get_screen('main').open_epson_tm88v_driver()

       

<LogWidget>:
    height: 200


<ConnectedImage>:
    source: app.connected_image if app.connected else app.disconnected_image
    height: 16
    keep_ratio: True